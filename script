--[[
    MM2 COIN FARM v11 - МАКСИМАЛЬНО ПРОСТОЙ
    - Фиксированная высота под картой
    - Плавный полёт
    - Сбор монет
    - Нет лагов
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer

-- ===== НАСТРОЙКИ (МИНИМУМ) =====
local config = {
    flySpeed = 40,
    toggleKey = Enum.KeyCode.F1,
    searchInterval = 0.5,
}

-- ===== ПЕРЕМЕННЫЕ =====
local character = nil
local rootPart = nil
local isFarming = false
local coinCount = 0
local flyConnection = nil
local currentTarget = nil
local currentTargetPos = nil
local nextSearchTime = 0
local guiRef = nil

-- ===== НОКЛИП =====
local function setNoclip(state)
    if not character then return end
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not state
        end
    end
end

-- ===== ПОИСК МОНЕТ (ТОЛЬКО ТЕ, ЧТО НАД ПОЛОМ) =====
local function getCoins()
    local coins = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Parent then
            local name = obj.Name:lower()
            if name:find("coin") or name:find("money") or name:find("gold") or name:find("cash") then
                -- Игнорируем монеты, которые уже под картой (чтобы не собирать их повторно)
                if obj.Position.Y > -10 then
                    table.insert(coins, obj)
                end
            end
        end
    end
    return coins
end

local function getClosestCoin()
    if not rootPart then return nil end
    local coins = getCoins()
    if #coins == 0 then return nil end
    
    local closest = nil
    local closestDist = math.huge
    local pos = rootPart.Position
    
    for _, coin in ipairs(coins) do
        if coin and coin.Parent then
            local dist = (coin.Position - pos).Magnitude
            if dist < closestDist then
                closestDist = dist
                closest = coin
            end
        end
    end
    return closest
end

-- ===== СБОР МОНЕТЫ =====
local function collectCoin(coin)
    if not coin or not coin.Parent then return false end
    
    local success = false
    pcall(function()
        -- ClickDetector
        local clickDet = coin:FindFirstChild("ClickDetector")
        if clickDet then
            clickDet:FireClick(player.Mouse)
            success = true
            return
        end
        
        -- Эмуляция касания
        local fakePart = Instance.new("Part")
        fakePart.CanCollide = false
        fakePart.Transparency = 1
        fakePart.Size = Vector3.new(0.5, 0.5, 0.5)
        fakePart.Position = coin.Position + Vector3.new(0, 1, 0)
        fakePart.Parent = workspace
        
        if coin.Touched then
            coin.Touched:Fire(fakePart)
            success = true
        end
        
        game:GetService("Debris"):AddItem(fakePart, 0.05)
    end)
    
    if success then
        coinCount = coinCount + 1
        return true
    end
    return false
end

-- ===== ОСНОВНОЙ ЦИКЛ =====
local function mainLoop()
    if not rootPart or not isFarming then return end
    
    -- Поиск новой цели (не чаще чем раз в 0.5 сек)
    local now = tick()
    if now - nextSearchTime >= config.searchInterval then
        nextSearchTime = now
        local coin = getClosestCoin()
        if coin then
            currentTarget = coin
            -- ВЫСОТА ФИКСИРОВАННАЯ: монета + смещение под карту
            currentTargetPos = coin.Position + Vector3.new(0, -8, 0)
        else
            currentTarget = nil
            currentTargetPos = nil
        end
    end
    
    -- Если цели нет - летим в случайную точку под картой
    if not currentTarget or not currentTargetPos then
        local time = tick()
        local randomPos = Vector3.new(
            math.sin(time * 0.3) * 30,
            -8,
            math.cos(time * 0.4) * 30
        )
        rootPart.CFrame = CFrame.new(randomPos)
        rootPart.Velocity = Vector3.new(math.sin(time * 0.3) * 10, 0, math.cos(time * 0.4) * 10)
        return
    end
    
    -- Летим к цели
    local currentPos = rootPart.Position
    local distance = (currentTargetPos - currentPos).Magnitude
    
    -- Если близко - собираем
    if distance < 10 then
        local collected = collectCoin(currentTarget)
        if collected then
            currentTarget = nil
            currentTargetPos = nil
            nextSearchTime = 0 -- сразу ищем новую
        end
        return
    end
    
    -- Плавный полёт
    local direction = (currentTargetPos - currentPos).Unit
    local newPos = currentPos + direction * config.flySpeed * 0.5
    rootPart.CFrame = CFrame.new(newPos)
    rootPart.Velocity = direction * config.flySpeed
end

-- ===== ВКЛЮЧЕНИЕ =====
local function startFarming()
    if isFarming then return end
    
    character = player.Character
    if not character then
        print("[MM2 Farm] ❌ Нет персонажа")
        return
    end
    
    rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        print("[MM2 Farm] ❌ Нет HumanoidRootPart")
        return
    end
    
    isFarming = true
    setNoclip(true)
    
    if flyConnection then flyConnection:Disconnect() end
    flyConnection = RunService.Heartbeat:Connect(mainLoop)
    
    currentTarget = nil
    currentTargetPos = nil
    nextSearchTime = 0
    
    updateUI()
    print("[MM2 Farm] ✅ ВКЛЮЧЁН")
end

-- ===== ВЫКЛЮЧЕНИЕ =====
local function stopFarming()
    if not isFarming then return end
    
    isFarming = false
    
    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end
    
    setNoclip(false)
    currentTarget = nil
    currentTargetPos = nil
    
    updateUI()
    print("[MM2 Farm] ❌ ВЫКЛЮЧЁН")
    print("[MM2 Farm] 📊 Собрано: " .. coinCount)
end

-- ===== ПЕРЕКЛЮЧЕНИЕ =====
local function toggleFarming()
    if isFarming then
        stopFarming()
    else
        startFarming()
    end
end

-- ===== GUI =====
local function updateUI()
    if not guiRef then return end
    
    local status = guiRef.Frame:FindFirstChild("StatusLabel")
    local btn = guiRef.Frame:FindFirstChild("ToggleButton")
    local stats = guiRef.Frame:FindFirstChild("StatsLabel")
    
    if status then
        status.Text = isFarming and "🟢 ВКЛЮЧЁН" or "⚪ ОТКЛЮЧЁН"
        status.TextColor3 = isFarming and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(255, 50, 50)
    end
    
    if btn then
        btn.Text = isFarming and "🔴 ВЫКЛЮЧИТЬ (F1)" or "🟢 ВКЛЮЧИТЬ (F1)"
        btn.BackgroundColor3 = isFarming and Color3.fromRGB(200, 0, 0) or Color3.fromRGB(0, 180, 0)
    end
    
    if stats then
        stats.Text = "🪙 Собрано: " .. coinCount
    end
end

