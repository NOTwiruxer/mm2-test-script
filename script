-- SWILL | MM2 Coin Collector (на основе кода YARHM)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer

local collecting = true
local collected = 0

local function getMap()
    for _, child in pairs(workspace:GetChildren()) do
        if child:FindFirstChild("CoinContainer") then
            return child
        end
    end
    return nil
end

local function getClosestCoin()
    local map = getMap()
    if not map then return nil end
    
    local coinContainer = map:FindFirstChild("CoinContainer")
    if not coinContainer then return nil end
    
    local character = LocalPlayer.Character
    if not character then return nil end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    
    local coins = coinContainer:GetChildren()
    if #coins == 0 then return nil end
    
    local closest = nil
    local closestDist = math.huge
    
    for _, coin in pairs(coins) do
        if coin:IsA("Model") then
            local pos = coin:GetPivot().Position
            local dist = (pos - root.Position).Magnitude
            if dist < closestDist then
                closestDist = dist
                closest = coin
            end
        end
    end
    
    return closest, closestDist
end

print("[SWILL] Запуск сбора монет...")

while collecting do
    task.wait(0.1)
    
    local character = LocalPlayer.Character
    if not character then continue end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then continue end
    
    local coin = getClosestCoin()
    if not coin then
        print("[SWILL] Монет нет на карте")
        continue
    end
    
    local pos = coin:GetPivot().Position
    local dist = (pos - root.Position).Magnitude
    
    -- Телепортируемся к монете
    local tween = TweenService:Create(root, TweenInfo.new(dist * 0.05, Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(pos + Vector3.new(0, 2, 0))
    })
    tween:Play()
    tween.Completed:Wait()
    
    task.wait(0.1)
    coin:Destroy()
    collected = collected + 1
    
    if collected % 10 == 0 then
        print("[SWILL] Собрано монет: " .. collected)
    end
end
