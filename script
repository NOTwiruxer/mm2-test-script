-- SWILL | Murder Mystery 2 - Auto Coin Collector (Object-based)
-- Для Delta Executor на телефоне

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

-- НАСТРОЙКИ
local COLLECT_RADIUS = 150        -- Радиус поиска монет
local CLICK_COOLDOWN = 0.15       -- Задержка между кликами

local lastClickTime = 0
local coinsCollected = 0

-- Функция поиска ближайшей монеты по объектам
local function findNearestCoin()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        return nil
    end

    local rootPart = character.HumanoidRootPart
    local rootPos = rootPart.Position
    local nearest = nil
    local nearestDist = COLLECT_RADIUS

    -- Ищем все объекты в игре
    for _, v in pairs(workspace:GetDescendants()) do
        -- Проверяем, является ли объект частью (BasePart)
        if v:IsA("BasePart") then
            -- Проверяем возможные имена монет
            if v.Name == "Coin" or v.Name == "Handle" then
                local pos = v.Position
                local dist = (pos - rootPos).Magnitude
                if dist < nearestDist then
                    nearest = v
                    nearestDist = dist
                end
            end
        end
    end

    return nearest, nearestDist
end

-- Функция клика по монете
local function clickAtScreenPosition(screenPos)
    -- Имитация нажатия мыши
    UserInputService:SetMouseButtonState(Enum.UserInputType.MouseButton1, true)
    task.wait(0.05)
    UserInputService:SetMouseButtonState(Enum.UserInputType.MouseButton1, false)

    lastClickTime = tick()
    coinsCollected = coinsCollected + 1
end

-- Основной цикл сбора
local function collectLoop()
    while true do
        task.wait(0.05)

        if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("Humanoid") then
            continue
        end

        local coin, dist = findNearestCoin()

        if coin and dist then
            local screenPos, onScreen = Camera:WorldToViewportPoint(coin.Position)

            if onScreen then
                if tick() - lastClickTime > CLICK_COOLDOWN then
                    clickAtScreenPosition(Vector2.new(screenPos.X, screenPos.Y))
                end
            else
                -- Если монета не на экране, можно повернуть камеру к ней
                local rootPos = LocalPlayer.Character.HumanoidRootPart.Position
                local direction = (coin.Position - rootPos).Unit
                local lookVector = Camera.CFrame.LookVector
                local angle = math.atan2(direction.X, direction.Z) - math.atan2(lookVector.X, lookVector.Z)
                local newCFrame = Camera.CFrame * CFrame.Angles(0, angle, 0)
                Camera.CFrame = Camera.CFrame:Lerp(newCFrame, 0.1)
            end
        end
    end
end

-- Запуск скрипта
print("[SWILL] Запуск сбора монет (поиск по объектам)")
task.spawn(collectLoop)
