--[[
    MM2 COIN FARM v9 - СБОР МОНЕТ ИСПРАВЛЕН
    - Правильный поиск монет
    - Полёт строго к монетам
    - Никаких случайных точек
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer

-- ===== НАСТРОЙКИ =====
local config = {
    heightOffset = -6,
    collectionDistance = 10,
    flySpeed = 45,
    toggleKey = Enum.KeyCode.F1,
}

-- ===== ПЕРЕМЕННЫЕ =====
local character = nil
local rootPart = nil
local humanoid = nil
local isFarming = false
local isCollecting = false
local coinCount = 0
local noclipParts = {}
local flyConnection = nil
local guiRef = nil
local nextSearchTime = 0
local searchCooldown = 0.5
local currentTarget = nil
local currentTargetPos = nil

-- ===== ПОЛУЧЕНИЕ ПЕРСОНАЖА =====
local function getCharacter()
    character = player.Character
    if character then
        rootPart = character:FindFirstChild("HumanoidRootPart")
        humanoid = character:FindFirstChild("Humanoid")
    end
    return character ~= nil
end

-- ===== НОКЛИП =====
local function applyNoclip()
    if not character then return end
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
    noclipParts = {}
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            table.insert(noclipParts, part)
        end
    end
end

local function removeNoclip()
    for _, part in ipairs(noclipParts) do
        if part and part.Parent then
            pcall(function()
                part.CanCollide = true
            end)
        end
    end
    noclipParts = {}
end

-- ===== ПОИСК МОНЕТ (улучшенный) =====
local function findCoins()
    local coins = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Parent then
            local name = obj.Name:lower()
            -- Расширенный список ключевых слов
            if name:find("coin") or name:find("money") or name:find("gold") or name:find("cash") or name:find("munny") then
                table.insert(coins, obj)
            elseif obj:FindFirstChild("ClickDetector") then
                table.insert(coins, obj)
            elseif obj:FindFirstChild("RemoteEvent") and obj.Name:find("coin") then
                table.insert(coins, obj)
            end
        end
    end
    return coins
end

local function findClosestCoin()
    if not rootPart then return nil end
    local coins = findCoins()
    if #coins == 0 then
        print("[MM2 Farm] ⚠️ Монеты не найдены на карте")
        return nil
    end
    
    local closest = nil
    local closestDist = math.huge
    local rootPos = rootPart.Position
    
    for _, coin in ipairs(coins) do
        if coin and coin.Parent then
            local dist = (coin.Position - rootPos).Magnitude
            if dist < closestDist then
                closestDist = dist
                closest = coin
            end
        end
    end
    
    if closest then
        print("[MM2 Farm] 🎯 Найдена монета на расстоянии: " .. math.floor(closestDist))
    end
    return closest, closestDist
end

-- ===== СБОР МОНЕТЫ =====
local function collectCoin(coin)
    if not coin or not coin.Parent then return false end
    
    local success = false
    pcall(function()
        -- Способ 1: ClickDetector
        local clickDet = coin:FindFirstChild("ClickDetector")
        if clickDet and clickDet:IsA("ClickDetector") then
            clickDet:FireClick(player.Mouse)
            success = true
            return
        end
        
        -- Способ 2: RemoteEvent
        local remote = coin:FindFirstChild("RemoteEvent") or coin:FindFirstChild("CollectEvent")
        if remote and remote:IsA("RemoteEvent") then
            remote:FireServer(player)
            success = true
            return
        end
        
        -- Способ 3: Эмуляция касания
        local fakePart = Instance.new("Part")
        fakePart.CanCollide = false
        fakePart.Transparency = 1
        fakePart.Size = Vector3.new(0.5, 0.5, 0.5)
        fakePart.Position = coin.Position + Vector3.new(0, 1, 0)
        fakePart.Parent = workspace
        
        if coin.Touched then
            coin.Touched:Fire(fakePart)
            success = true
        end
        
        game:GetService("Debris"):AddItem(fakePart, 0.05)
        
        if not success then
            coin.Position = rootPart.Position + Vector3.new(0, -3, 0)
            success = true
        end
    end)
    
    if success then
        coinCount = coinCount + 1
        print("[MM2 Farm] 🪙 Монета собрана! Всего: " .. coinCount)
        return true
    end
    return false
end

-- ===== ОСНОВНОЙ ЦИКЛ =====
local function farmingLoop()
    if not rootPart or not isFarming then return end
    
    -- 1. Поиск цели (если нет текущей цели или она исчезла)
    local now = tick()
    if (not currentTarget or not currentTarget.Parent) and now - nextSearchTime >= searchCooldown then
        nextSearchTime = now
        local target, dist = findClosestCoin()
        if target then
            currentTarget = target
            currentTargetPos = target.Position + Vector3.new(0, config.heightOffset, 0)
            print("[MM2 Farm] 🎯 Новая цель: " .. target.Name .. " (дист: " .. math.floor(dist) .. ")")
        else
            currentTarget = nil
            currentTargetPos = nil
        end
    end
    
    -- 2. Если цели нет - ищем снова (следующий цикл)
    if not currentTarget or not currentTarget.Parent then
        currentTarget = nil
        currentTargetPos = nil
        return
    end
    
    -- 3. Обновляем позицию цели (на случай, если монета двигается)
    if currentTarget and currentTarget.Parent then
        currentTargetPos = currentTarget.Position + Vector3.new(0, config.heightOffset, 0)
    end
    
    -- 4. Проверяем расстояние до цели
    local currentPos = rootPart.Position
    local distance = (currentTargetPos - currentPos).Magnitude
    
    -- 5. Если близко - собираем
    if distance < config.collectionDistance then
        print("[MM2 Farm] 📍 Близко к монете! Собираем...")
        local collected = collectCoin(currentTarget)
        if collected then
            currentTarget = nil
            currentTargetPos = nil
        end
        return
    end
    
    -- 6. Летим к цели
    local direction = (currentTargetPos - currentPos).Unit
    local newPos = currentPos + direction * config.flySpeed * 0.5
    
    -- Устанавливаем позицию
    rootPart.CFrame = CFrame.new(newPos)
    rootPart.Velocity = direction * config.flySpeed * 0.5
    
    -- Логируем движение (редко)
    if math.random(1, 20) == 1 then
        print("[MM2 Farm] ✈️ Летим к монете... " .. math.floor(distance) .. " единиц")
    end
end

-- ===== ОБНОВЛЕНИЕ GUI =====
local function updateUI()
    if not guiRef then return end
    
    local status = guiRef.Frame:FindFirstChild("StatusLabel")
    local btn = guiRef.Frame:FindFirstChild("ToggleButton")
    local stats = guiRef.Frame:FindFirstChild("StatsLabel")
    local height = guiRef.Frame:FindFirstChild("HeightLabel")
    
    if status then
        status.Text = isFarming and "🟢 ВКЛЮЧЁН" or "⚪ ОТКЛЮЧЁН"
        status.TextColor3 = isFarming and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(255, 50, 50)
    end
    
    if btn then
        btn.Text = isFarming and "🔴 ВЫКЛЮЧИТЬ (F1)" or "🟢 ВКЛЮЧИТЬ (F1)"
        btn.BackgroundColor3 = isFarming and Color3.fromRGB(200, 0, 0) or Color3.fromRGB(0, 180, 0)
    end
    
    if stats then
        stats.Text = "🪙 Собрано: " .. coinCount
    end
    
    if height then
        height.Text = "Высота: " .. config.heightOffset
    end
end

-- ===== ВКЛЮЧЕНИЕ =====
local function startFarming()
    if isFarming then return end
    if not getCharacter() then
        print("[MM2 Farm] ❌ Персонаж не найден")
        return
    end
    
    isFarming = true
    applyNoclip()
    
    if flyConnection then flyConnection:Disconnect() end
    flyConnection = RunService.Heartbeat:Connect(farmingLoop)
    
    if humanoid then
        humanoid.PlatformStand = true
    end
    
    currentTarget = nil
    currentTargetPos = nil
    
    updateUI()
    print("========================================")
    print("[MM2 Farm] ✅ АВТОФАРМ ВКЛЮЧЁН")
    print("[MM2 Farm] 🔹 Высота: " .. config.heightOffset)
    print("[MM2 Farm] 🔹 Поиск монет каждые " .. searchCooldown .. " сек")
    print("========================================")
end

-- ===== ВЫКЛЮЧЕНИЕ =====
local function stopFarming()
    if not isFarming then return end
    
    isFarming = false
    
    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end
    
    if humanoid then
        humanoid.PlatformStand = false
    end
    
    removeNoclip()
    currentTarget = nil
    currentTargetPos = nil
    
    updateUI()
    print("========================================")
    print("[MM2 Farm] ❌ АВТОФАРМ ВЫКЛЮЧЁН")
    print("[MM2 Farm] 📊 Собрано: " .. coinCount .. " монет")
    print("========================================")
end

-- ===== ПЕРЕКЛЮЧЕНИЕ =====
local function toggleFarming()
    if isFarming then
        stopFarming()
    else
        startFarming()
    end
end

