-- SWILL | MM2 Coin Collector (FINAL)
-- Фиксы: телепорт под карту + реальный счётчик монет

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- ===== НАСТРОЙКИ =====
local TELEPORT_OFFSET = -5          -- Отрицательное значение = под карту
local COLLECT_INTERVAL = 0.1
local DETECTION_RADIUS = 3           -- Радиус сбора (чтобы подбирать монеты под картой)

-- ===== ПЕРЕМЕННЫЕ =====
local collected = 0
local running = true
local lastCollect = 0
local coinCountLabel = nil

-- ===== ПЕРЕХВАТ СОБЫТИЯ СБОРА МОНЕТ =====
-- Слушаем событие, когда игрок подбирает монету
local function hookCoinCollection()
    -- Ищем RemoteEvent для сбора монет
    local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
    if remotes then
        local gameplay = remotes:FindFirstChild("Gameplay")
        if gameplay then
            -- Слушаем событие, которое запускается при сборе монеты
            for _, child in pairs(gameplay:GetChildren()) do
                if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                    -- Пытаемся подключиться к событию OnClientEvent
                    if child.OnClientEvent then
                        child.OnClientEvent:Connect(function(...)
                            local args = {...}
                            -- Проверяем, есть ли в аргументах упоминание о монете
                            for _, arg in pairs(args) do
                                if type(arg) == "string" and arg:lower():find("coin") then
                                    collected = collected + 1
                                    updateCounter()
                                    break
                                end
                            end
                        end)
                    end
                end
            end
        end
    end
    
    -- Альтернативный способ: слушаем изменение в CoinContainer
    task.spawn(function()
        while running do
            task.wait(0.5)
            -- Обновляем счётчик из CoinContainer (если есть)
            local map = getMap()
            if map then
                local coinContainer = map:FindFirstChild("CoinContainer")
                if coinContainer then
                    local coins = coinContainer:GetChildren()
                    if #coins > 0 then
                        -- Считаем собранные монеты по разнице
                    end
                end
            end
        end
    end)
end

-- ===== ПОИСК КАРТЫ =====
local function getMap()
    for _, child in pairs(workspace:GetChildren()) do
        if child:FindFirstChild("CoinContainer") then
            return child
        end
    end
    return nil
end

-- ===== ПОИСК МОНЕТ С РАСШИРЕННЫМ ДИАПАЗОНОМ =====
local function getAllCoins()
    local coins = {}
    
    for _, obj in pairs(workspace:GetDescendants()) do
        local name = obj.Name:lower()
        if name == "coin" or name:find("coin") then
            if obj:IsA("Model") then
                local handle = obj:FindFirstChild("Handle")
                if handle and handle:IsA("BasePart") then
                    table.insert(coins, handle)
                else
                    for _, part in pairs(obj:GetChildren()) do
                        if part:IsA("BasePart") then
                            table.insert(coins, part)
                            break
                        end
                    end
                end
            elseif obj:IsA("BasePart") then
                table.insert(coins, obj)
            end
        end
    end
    
    return coins
end

-- ===== ПОИСК БЛИЖАЙШЕЙ МОНЕТЫ =====
local function findNearestCoin()
    local character = LocalPlayer.Character
    if not character then return nil end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    
    local rootPos = root.Position
    local coins = getAllCoins()
    
    if #coins == 0 then return nil end
    
    local nearest = nil
    local nearestDist = math.huge
    
    for _, coin in pairs(coins) do
        if coin and coin:IsA("BasePart") then
            local dist = (coin.Position - rootPos).Magnitude
            if dist < nearestDist then
                nearestDist = dist
                nearest = coin
            end
        end
    end
    
    return nearest, nearestDist
end

-- ===== ТЕЛЕПОРТ ПОД КАРТУ =====
local function teleportToCoin(coin)
    local character = LocalPlayer.Character
    if not character then return false end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    
    if tick() - lastCollect < COLLECT_INTERVAL then
        return false
    end
    
    local pos = coin.Position
    
    -- Телепортируемся ПОД карту (отрицательный Y)
    root.CFrame = CFrame.new(pos.X, pos.Y + TELEPORT_OFFSET, pos.Z)
    
    -- Проверяем, собралась ли монета (по расстоянию)
    task.wait(0.05)
    local newPos = root.Position
    local distToCoin = (newPos - pos).Magnitude
    
    -- Если мы рядом с монетой (в радиусе сбора) - считаем собранной
    if distToCoin < DETECTION_RADIUS then
        -- Удаляем монету, чтобы не собирать её снова
        if coin.Parent and coin.Parent:IsA("Model") then
            coin.Parent:Destroy()
        else
            coin:Destroy()
        end
        
        -- Счётчик обновится через событие, но на всякий случай увеличиваем здесь
        collected = collected + 1
        updateCounter()
    end
    
    lastCollect = tick()
    
    return true
end

-- ===== ОБНОВЛЕНИЕ СЧЁТЧИКА =====
local function updateCounter()
    if coinCountLabel then
        coinCountLabel.Text = "SWILL | " .. collected .. " монет"
    end
end

-- ===== GUI =====
local function createGUI()
    local ScreenGui = Instance.new("ScreenGui")
    local Frame = Instance.new("Frame")
    local TextLabel = Instance.new("TextLabel")
    local CloseButton = Instance.new("TextButton")
    
    ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    ScreenGui.Name = "SWILL_CoinCollector"
    ScreenGui.ResetOnSpawn = false
    
    Frame.Parent = ScreenGui
    Frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    Frame.BackgroundTransparency = 0.6
    Frame.Size = UDim2.new(0, 200, 0, 50)
    Frame.Position = UDim2.new(0, 10, 0, 10)
    Frame.BorderSizePixel = 0
    
    TextLabel.Parent = Frame
    TextLabel.BackgroundTransparency = 1
    TextLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
    TextLabel.Size = UDim2.new(1, 0, 1, 0)
    TextLabel.Text = "SWILL | 0 монет"
    TextLabel.Font = Enum.Font.GothamBold
    TextLabel.TextSize = 16
    TextLabel.TextScaled = true
    coinCountLabel = TextLabel
    
    CloseButton.Parent = Frame
    CloseButton.BackgroundTransparency = 1
    CloseButton.Size = UDim2.new(0, 25, 0, 25)
    CloseButton.Position = UDim2.new(1, -30, 0, 5)
    CloseButton.Text = "X"
    CloseButton.TextColor3 = Color3.fromRGB(255, 0, 0)
    CloseButton.TextScaled = true
    CloseButton.Font = Enum.Font.GothamBold
    
    CloseButton.MouseButton1Click:Connect(function()
        running = false
        ScreenGui:Destroy()
        print("[SWILL] Сбор остановлен. Всего монет:", collected)
    end)
    
    return ScreenGui
end

-- ===== ОСНОВНОЙ ЦИКЛ =====
local function main()
    print("[SWILL] Запуск авто-сбора монет (под карту)")
    print("[SWILL] Телепорт под карту: Y = " .. TELEPORT_OFFSET)
    
    createGUI()
    
    -- Подключаем перехват событий сбора монет
    hookCoinCollection()
    
    while running do
        task.wait(0.05)
        
        local character = LocalPlayer.Character
        if not character then
            task.wait(1)
            continue
        end
        
        local root = character:FindFirstChild("HumanoidRootPart")
        if not root then
            task.wait(1)
            continue
        end
        
        local coin = findNearestCoin()
        if coin then
            teleportToCoin(coin)
        else
            -- Если монет нет, просто ждём
            task.wait(0.3)
        end
    end
end

task.spawn(main)

print("[SWILL] Скрипт загружен. Нажми X на GUI для остановки.")
