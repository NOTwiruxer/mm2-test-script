--[[
    MM2 COIN FARM v4 - ПЛАВНЫЙ ПОЛЁТ + ОПТИМИЗАЦИЯ
    - Реальный полёт (BodyVelocity + BodyGyro)
    - Поиск монет только после сбора
    - Нет лагов
    - Регулировка высоты
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer

-- ===== НАСТРОЙКИ =====
local config = {
    enabled = false,
    heightOffset = -6,                       -- Высота под картой (регулируй)
    collectionDistance = 8,                  -- Дистанция сбора
    flySpeed = 40,                           -- Скорость полёта
    toggleKey = Enum.KeyCode.F1,
}

-- ===== ПЕРЕМЕННЫЕ =====
local character = nil
local rootPart = nil
local humanoid = nil
local isFarming = false
local isCollecting = false                  -- Флаг: сейчас идёт сбор
local currentTarget = nil
local coinCount = 0
local noclipParts = {}

-- ===== ТЕЛО ДЛЯ ФИЗИКИ =====
local bodyVelocity = nil
local bodyGyro = nil

-- ===== ПОЛУЧЕНИЕ ПЕРСОНАЖА =====
local function getCharacter()
    character = player.Character
    if character then
        humanoid = character:FindFirstChild("Humanoid")
        rootPart = character:FindFirstChild("HumanoidRootPart")
        if humanoid then
            humanoid.PlatformStand = true
        end
    end
    return character ~= nil
end

-- ===== СОЗДАНИЕ ФИЗИКИ ПОЛЁТА =====
local function createFlightPhysics()
    if not rootPart then return end
    
    -- Удаляем старую физику
    if bodyVelocity then bodyVelocity:Destroy() end
    if bodyGyro then bodyGyro:Destroy() end
    
    -- BodyVelocity для движения
    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(4000, 4000, 4000)
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.Parent = rootPart
    
    -- BodyGyro для стабилизации
    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(4000, 4000, 4000)
    bodyGyro.CFrame = rootPart.CFrame
    bodyGyro.Parent = rootPart
end

-- ===== УДАЛЕНИЕ ФИЗИКИ =====
local function destroyFlightPhysics()
    if bodyVelocity then
        bodyVelocity:Destroy()
        bodyVelocity = nil
    end
    if bodyGyro then
        bodyGyro:Destroy()
        bodyGyro = nil
    end
    if humanoid then
        humanoid.PlatformStand = false
    end
end

-- ===== НОКЛИП =====
local function enableNoclip()
    if not character then return end
    noclipParts = {}
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
            table.insert(noclipParts, part)
        end
    end
end

local function disableNoclip()
    for _, part in ipairs(noclipParts) do
        if part and part.Parent then
            part.CanCollide = true
        end
    end
    noclipParts = {}
end

-- ===== ПОИСК БЛИЖАЙШЕЙ МОНЕТЫ (ОДИН РАЗ) =====
local function findClosestCoin()
    if not rootPart then return nil end
    
    local closest = nil
    local closestDist = math.huge
    local rootPos = rootPart.Position
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Parent then
            local name = obj.Name:lower()
            if name:find("coin") or name:find("money") or name:find("gold") or name:find("cash") then
                local dist = (obj.Position - rootPos).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closest = obj
                end
            end
        end
    end
    
    return closest, closestDist
end

-- ===== ПОДЛЁТ К МОНЕТЕ (ПЛАВНЫЙ) =====
local function flyToTarget(target)
    if not rootPart or not target or not target.Parent then return false end
    
    local targetPos = target.Position + Vector3.new(0, config.heightOffset, 0)
    local currentPos = rootPart.Position
    local distance = (targetPos - currentPos).Magnitude
    
    -- Если уже рядом — собираем
    if distance < config.collectionDistance then
        return true
    end
    
    -- Плавный полёт через BodyVelocity
    local direction = (targetPos - currentPos).Unit
    local speed = config.flySpeed
    
    if bodyVelocity then
        bodyVelocity.Velocity = direction * speed
    end
    
    -- Стабилизация
    if bodyGyro then
        bodyGyro.CFrame = CFrame.new(rootPart.Position, targetPos)
    end
    
    return false
end

-- ===== СБОР МОНЕТЫ =====
local function collectCoin(coin)
    if not coin or not coin.Parent then return false end
    
    local success = false
    pcall(function()
        -- ClickDetector
        local clickDet = coin:FindFirstChild("ClickDetector")
        if clickDet and clickDet:IsA("ClickDetector") then
            clickDet:FireClick(player.Mouse)
            success = true
            return
        end
        
        -- RemoteEvent
        local remote = coin:FindFirstChild("RemoteEvent") or coin:FindFirstChild("CollectEvent")
        if remote and remote:IsA("RemoteEvent") then
            remote:FireServer(player)
            success = true
            return
        end
        
        -- Эмуляция касания
        local fakePart = Instance.new("Part")
        fakePart.CanCollide = false
        fakePart.Transparency = 1
        fakePart.Size = Vector3.new(0.5, 0.5, 0.5)
        fakePart.Position = coin.Position + Vector3.new(0, 1, 0)
        fakePart.Parent = workspace
        
        if coin.Touched then
            coin.Touched:Fire(fakePart)
            success = true
        end
        
        game:GetService("Debris"):AddItem(fakePart, 0.05)
        
        if not success then
            coin.Position = rootPart.Position + Vector3.new(0, -3, 0)
            success = true
        end
    end)
    
    if success then
        coinCount = coinCount + 1
        return true
    end
    return false
end

-- ===== ОСНОВНОЙ ЦИКЛ (ВЫЗЫВАЕТСЯ ТОЛЬКО ПОСЛЕ СБОРА) =====
local function farmingLoop()
    if not rootPart or not isFarming or isCollecting then return end
    
    isCollecting = true
    
    -- 1. Находим ближайшую монету
    local target, dist = findClosestCoin()
    
    if not target then
        -- Нет монет — летим в случайную точку под картой
        local randomPos = Vector3.new(
            math.random(-50, 50),
            config.heightOffset,
            math.random(-50, 50)
        )
        if bodyVelocity then
            bodyVelocity.Velocity = (randomPos - rootPart.Position).Unit * config.flySpeed * 0.5
        end
        isCollecting = false
        return
    end
    
    -- 2. Летим к монете
    local arrived = flyToTarget(target)
    
    if not arrived then
        -- Ещё летим
        isCollecting = false
        return
    end
    
    -- 3. Собираем монету
    local collected = collectCoin(target)
    
    if collected then
        print("[MM2 Farm] 🪙 +1 монета (всего: " .. coinCount .. ")")
        -- Небольшая задержка перед поиском следующей
        task.wait(0.1)
    end
    
    -- 4. Завершаем цикл — следующий вызов найдёт новую цель
    isCollecting = false
end

-- ===== ВКЛЮЧЕНИЕ =====
local function startFarming()
    if isFarming then return end
    if not getCharacter() then
        print("[MM2 Farm] ❌ Персонаж не найден")
        return
    end
    
    isFarming = true
    enableNoclip()
    createFlightPhysics()
    
    -- Запускаем цикл сбора (Heartbeat)
    RunService.Heartbeat:Connect(function()
        if isFarming and rootPart then
            farmingLoop()
        end
    end)
    
    print("[MM2 Farm] ✅ АВТОФАРМ ВКЛЮЧЁН")
    print("[MM2 Farm] 🔹 Высота: " .. config.heightOffset)
end

-- ===== ВЫКЛЮЧЕНИЕ =====
local function stopFarming()
    if not isFarming then return end
    
    isFarming = false
    isCollecting = false
    
    destroyFlightPhysics()
    disableNoclip()
    
    print("[MM2 Farm] ❌ АВТОФАРМ ВЫКЛЮЧЁН")
    print("[MM2 Farm] 📊 Всего собрано: " .. coinCount .. " монет")
end

-- ===== ПЕРЕКЛЮЧЕНИЕ =====
local function toggleFarming()
    if isFarming then
        stopFarming()
    else
        startFarming()
    end
end

