-- SWILL | Murder Mystery 2 - Оптимизированный сбор монет
-- Основан на анализе рабочих примеров

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- ===== НАСТРОЙКИ =====
local CONFIG = {
    TeleportCooldown = 0.15,        -- Задержка между телепортами
    SearchRadius = 500,             -- Радиус для сбора монет
}

-- ===== ОСНОВНАЯ ФУНКЦИЯ СБОРА =====
local function collectCoins()
    local character = LocalPlayer.Character
    if not character then return end

    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    -- 1. Ищем все монеты в игровом мире.
    -- Вместо жесткого пути (workspace.Map.Coins), ищем по имени "CoinContainer" или "Coins" [citation:1][citation:2]
    local coins = {}
    for _, v in pairs(workspace:GetDescendants()) do
        -- Проверяем, что объект — это модель монеты, и она существует
        if v:IsA("Model") and v.Name == "Coin" and v:FindFirstChild("Handle") then
            -- Дополнительная проверка: монета прозрачна, если она уже собрана
            local handle = v.Handle
            if handle.Transparency < 1 then
                table.insert(coins, handle)
            end
        end
    end

    -- 2. Находим ближайшую монету
    local nearestCoin = nil
    local shortestDist = CONFIG.SearchRadius
    local rootPos = rootPart.Position

    for _, coin in pairs(coins) do
        local dist = (coin.Position - rootPos).Magnitude
        if dist < shortestDist then
            nearestCoin = coin
            shortestDist = dist
        end
    end

    -- 3. Телепортируемся к найденной монете
    if nearestCoin then
        -- Небольшое смещение вверх, чтобы избежать застревания в полу [citation:8]
        local teleportPos = nearestCoin.Position + Vector3.new(0, 2, 0)
        rootPart.CFrame = CFrame.new(teleportPos)
        return true -- Успешно собрали
    end

    return false -- Монет в радиусе нет
end

-- ===== ОСНОВНОЙ ЦИКЛ =====
print("[SWILL] Запуск сбора монет...")
while true do
    task.wait(CONFIG.TeleportCooldown)
    
    -- Проверяем, жив ли игрок, чтобы избежать ошибок
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        collectCoins()
    end
end
