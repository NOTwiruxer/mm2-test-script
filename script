--[[
    MM2 COIN FARM v6 - СТАТУС ИСПРАВЛЕН + НЕТ РЕГДОЛЛА
    - GUI обновляется всегда
    - Персонаж НЕ падает (анти-регдолл)
    - Плавный полёт
    - Оптимизированный поиск монет
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer

-- ===== НАСТРОЙКИ =====
local config = {
    heightOffset = -6,
    collectionDistance = 8,
    flySpeed = 40,
    toggleKey = Enum.KeyCode.F1,
}

-- ===== ПЕРЕМЕННЫЕ =====
local character = nil
local rootPart = nil
local humanoid = nil
local isFarming = false
local isCollecting = false
local coinCount = 0
local noclipParts = {}

-- ФИЗИКА ПОЛЁТА
local bodyVelocity = nil
local bodyGyro = nil

-- GUI
local guiRef = nil
local statusRef = nil
local buttonRef = nil
local statsRef = nil
local heightRef = nil

-- Таймер для поиска монет
local nextSearchTime = 0
local searchCooldown = 0.3

-- ===== ПОЛУЧЕНИЕ ПЕРСОНАЖА =====
local function getCharacter()
    character = player.Character
    if character then
        rootPart = character:FindFirstChild("HumanoidRootPart")
        humanoid = character:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.PlatformStand = true
        end
        if isFarming then
            applyNoclip()
            createFlightPhysics()
        end
    end
    return character ~= nil
end

-- ===== НОКЛИП =====
local function applyNoclip()
    if not character then return end
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
    noclipParts = {}
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            table.insert(noclipParts, part)
        end
    end
end

local function removeNoclip()
    for _, part in ipairs(noclipParts) do
        if part and part.Parent then
            pcall(function()
                part.CanCollide = true
            end)
        end
    end
    noclipParts = {}
end

-- ===== СОЗДАНИЕ ФИЗИКИ ПОЛЁТА (АНТИ-РЕГДОЛЛ) =====
local function createFlightPhysics()
    if not rootPart then return end
    destroyFlightPhysics()
    
    -- BodyVelocity для движения
    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(4000, 4000, 4000)
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.Parent = rootPart
    
    -- BodyGyro для стабилизации
    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(4000, 4000, 4000)
    bodyGyro.CFrame = rootPart.CFrame
    bodyGyro.Parent = rootPart
    
    -- Включаем PlatformStand, чтобы персонаж не падал
    if humanoid then
        humanoid.PlatformStand = true
    end
end

local function destroyFlightPhysics()
    if bodyVelocity then
        bodyVelocity:Destroy()
        bodyVelocity = nil
    end
    if bodyGyro then
        bodyGyro:Destroy()
        bodyGyro = nil
    end
    if humanoid then
        humanoid.PlatformStand = false
    end
end

-- ===== ПОИСК МОНЕТ =====
local function findCoins()
    local coins = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Parent then
            local name = obj.Name:lower()
            if name:find("coin") or name:find("money") or name:find("gold") or name:find("cash") then
                table.insert(coins, obj)
            end
        end
    end
    return coins
end

local function findClosestCoin()
    if not rootPart then return nil end
    local coins = findCoins()
    if #coins == 0 then return nil end
    
    local closest = nil
    local closestDist = math.huge
    local rootPos = rootPart.Position
    
    for _, coin in ipairs(coins) do
        if coin and coin.Parent then
            local dist = (coin.Position - rootPos).Magnitude
            if dist < closestDist then
                closestDist = dist
                closest = coin
            end
        end
    end
    return closest, closestDist
end

-- ===== ПОДЛЁТ =====
local function flyToTarget(target)
    if not rootPart or not target or not target.Parent then return false end
    
    local targetPos = target.Position + Vector3.new(0, config.heightOffset, 0)
    local currentPos = rootPart.Position
    local distance = (targetPos - currentPos).Magnitude
    
    if distance < config.collectionDistance then
        return true
    end
    
    local direction = (targetPos - currentPos).Unit
    if bodyVelocity then
        bodyVelocity.Velocity = direction * config.flySpeed
    end
    if bodyGyro then
        bodyGyro.CFrame = CFrame.new(rootPart.Position, targetPos)
    end
    
    return false
end

-- ===== СБОР МОНЕТЫ =====
local function collectCoin(coin)
    if not coin or not coin.Parent then return false end
    
    local success = false
    pcall(function()
        local clickDet = coin:FindFirstChild("ClickDetector")
        if clickDet and clickDet:IsA("ClickDetector") then
            clickDet:FireClick(player.Mouse)
            success = true
            return
        end
        
        local remote = coin:FindFirstChild("RemoteEvent") or coin:FindFirstChild("CollectEvent")
        if remote and remote:IsA("RemoteEvent") then
            remote:FireServer(player)
            success = true
            return
        end
        
        local fakePart = Instance.new("Part")
        fakePart.CanCollide = false
        fakePart.Transparency = 1
        fakePart.Size = Vector3.new(0.5, 0.5, 0.5)
        fakePart.Position = coin.Position + Vector3.new(0, 1, 0)
        fakePart.Parent = workspace
        
        if coin.Touched then
            coin.Touched:Fire(fakePart)
            success = true
        end
        
        game:GetService("Debris"):AddItem(fakePart, 0.05)
        
        if not success then
            coin.Position = rootPart.Position + Vector3.new(0, -3, 0)
            success = true
        end
    end)
    
    if success then
        coinCount = coinCount + 1
        return true
    end
    return false
end

-- ===== ОСНОВНОЙ ЦИКЛ =====
local function farmingLoop()
    if not rootPart or not isFarming or isCollecting then return end
    
    isCollecting = true
    
    local now = tick()
    if now - nextSearchTime < searchCooldown then
        isCollecting = false
        return
    end
    nextSearchTime = now
    
    local target, dist = findClosestCoin()
    
    if not target then
        local randomPos = Vector3.new(
            math.random(-50, 50),
            config.heightOffset,
            math.random(-50, 50)
        )
        if bodyVelocity then
            bodyVelocity.Velocity = (randomPos - rootPart.Position).Unit * config.flySpeed * 0.3
        end
        isCollecting = false
        return
    end
    
    local arrived = flyToTarget(target)
    if not arrived then
        isCollecting = false
        return
    end
    
    collectCoin(target)
    task.wait(0.1)
    isCollecting = false
end

-- ===== ОБНОВЛЕНИЕ GUI =====
local function updateUI()
    if not guiRef then return end
    
    local status = guiRef.Frame:FindFirstChild("StatusLabel")
    local btn = guiRef.Frame:FindFirstChild("ToggleButton")
    local stats = guiRef.Frame:FindFirstChild("StatsLabel")
    local height = guiRef.Frame:FindFirstChild("HeightLabel")
    
    if status then
        if isFarming then
            status.Text = "🟢 ВКЛЮЧЁН"
            status.TextColor3 = Color3.fromRGB(50, 255, 50)
        else
            status.Text = "⚪ ОТКЛЮЧЁН"
            status.TextColor3 = Color3.fromRGB(255, 50, 50)
        end
    end
    
    if btn then
        if isFarming then
            btn.Text = "🔴 ВЫКЛЮЧИТЬ (F1)"
            btn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        else
            btn.Text = "🟢 ВКЛЮЧИТЬ (F1)"
            btn.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
        end
    end
    
    if stats then
        stats.Text = "🪙 Собрано: " .. coinCount
    end
    
    if height then
        height.Text = "Высота: " .. config.heightOffset
    end
end

-- ===== ВКЛЮЧЕНИЕ =====
local function startFarming()
    if isFarming then return end
    if not getCharacter() then
        print("[MM2 Farm] ❌ Персонаж не найден")
        return
    end
    
    isFarming = true
    applyNoclip()
    createFlightPhysics()
    
    RunService.Heartbeat:Connect(function()
        if isFarming and rootPart then
            farmingLoop()
        end
    end)
    
    updateUI()
    print("[MM2 Farm] ✅ ВКЛЮЧЁН")
end

-- ===== ВЫКЛЮЧЕНИЕ =====
local function stopFarming()
    if not isFarming then return end
    
    isFarming = false
    isCollecting = false
    destroyFlightPhysics()
    removeNoclip()
    
    updateUI()
    print("[MM2 Farm] ❌ ВЫКЛЮЧЁН")
    print("[MM2 Farm] 📊 Собрано: " .. coinCount)
end

-- ===== ПЕРЕКЛЮЧЕНИЕ =====
local function toggleFarming()
    if isFarming then
        stopFarming()
    else
        startFarming()
    end
end

