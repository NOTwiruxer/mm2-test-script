-- SWILL | MM2 Coin Collector (Working)
-- Фиксы: телепорт под карту + реальный счётчик монет

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- ===== НАСТРОЙКИ =====
local TELEPORT_OFFSET = -5          -- Под карту
local COLLECT_INTERVAL = 0.1

-- ===== ПЕРЕМЕННЫЕ =====
local collected = 0
local running = true
local lastCollect = 0
local coinCountLabel = nil

-- ===== ПОИСК МОНЕТ =====
local function getAllCoins()
    local coins = {}
    
    for _, obj in pairs(workspace:GetDescendants()) do
        local name = obj.Name:lower()
        if name == "coin" or name:find("coin") then
            if obj:IsA("Model") then
                local handle = obj:FindFirstChild("Handle")
                if handle and handle:IsA("BasePart") then
                    table.insert(coins, handle)
                else
                    for _, part in pairs(obj:GetChildren()) do
                        if part:IsA("BasePart") then
                            table.insert(coins, part)
                            break
                        end
                    end
                end
            elseif obj:IsA("BasePart") then
                table.insert(coins, obj)
            end
        end
    end
    
    return coins
end

-- ===== ПОИСК БЛИЖАЙШЕЙ МОНЕТЫ =====
local function findNearestCoin()
    local character = LocalPlayer.Character
    if not character then return nil end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    
    local rootPos = root.Position
    local coins = getAllCoins()
    
    if #coins == 0 then return nil end
    
    local nearest = nil
    local nearestDist = math.huge
    
    for _, coin in pairs(coins) do
        if coin and coin:IsA("BasePart") then
            local dist = (coin.Position - rootPos).Magnitude
            if dist < nearestDist then
                nearestDist = dist
                nearest = coin
            end
        end
    end
    
    return nearest, nearestDist
end

-- ===== ТЕЛЕПОРТ ПОД КАРТУ + СБОР =====
local function teleportToCoin(coin)
    local character = LocalPlayer.Character
    if not character then return false end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    
    if tick() - lastCollect < COLLECT_INTERVAL then
        return false
    end
    
    local pos = coin.Position
    
    -- Телепортируемся ПОД карту
    root.CFrame = CFrame.new(pos.X, pos.Y + TELEPORT_OFFSET, pos.Z)
    
    -- Удаляем монету (она собрана)
    if coin.Parent and coin.Parent:IsA("Model") then
        coin.Parent:Destroy()
    else
        coin:Destroy()
    end
    
    -- Увеличиваем счётчик
    collected = collected + 1
    updateCounter()
    
    lastCollect = tick()
    
    return true
end

-- ===== ОБНОВЛЕНИЕ СЧЁТЧИКА =====
local function updateCounter()
    if coinCountLabel then
        coinCountLabel.Text = "SWILL | " .. collected .. " монет"
    end
end

-- ===== GUI =====
local function createGUI()
    local ScreenGui = Instance.new("ScreenGui")
    local Frame = Instance.new("Frame")
    local TextLabel = Instance.new("TextLabel")
    local CloseButton = Instance.new("TextButton")
    
    ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    ScreenGui.Name = "SWILL_CoinCollector"
    ScreenGui.ResetOnSpawn = false
    
    Frame.Parent = ScreenGui
    Frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    Frame.BackgroundTransparency = 0.6
    Frame.Size = UDim2.new(0, 200, 0, 50)
    Frame.Position = UDim2.new(0, 10, 0, 10)
    Frame.BorderSizePixel = 0
    
    TextLabel.Parent = Frame
    TextLabel.BackgroundTransparency = 1
    TextLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
    TextLabel.Size = UDim2.new(1, 0, 1, 0)
    TextLabel.Text = "SWILL | 0 монет"
    TextLabel.Font = Enum.Font.GothamBold
    TextLabel.TextSize = 16
    TextLabel.TextScaled = true
    coinCountLabel = TextLabel
    
    CloseButton.Parent = Frame
    CloseButton.BackgroundTransparency = 1
    CloseButton.Size = UDim2.new(0, 25, 0, 25)
    CloseButton.Position = UDim2.new(1, -30, 0, 5)
    CloseButton.Text = "X"
    CloseButton.TextColor3 = Color3.fromRGB(255, 0, 0)
    CloseButton.TextScaled = true
    CloseButton.Font = Enum.Font.GothamBold
    
    CloseButton.MouseButton1Click:Connect(function()
        running = false
        ScreenGui:Destroy()
        print("[SWILL] Сбор остановлен. Всего монет:", collected)
    end)
    
    return ScreenGui
end

-- ===== ОСНОВНОЙ ЦИКЛ =====
local function main()
    print("[SWILL] Запуск авто-сбора монет (под карту)")
    
    createGUI()
    
    while running do
        task.wait(0.05)
        
        local character = LocalPlayer.Character
        if not character then
            task.wait(1)
            continue
        end
        
        local root = character:FindFirstChild("HumanoidRootPart")
        if not root then
            task.wait(1)
            continue
        end
        
        local coin = findNearestCoin()
        if coin then
            teleportToCoin(coin)
        else
            task.wait(0.3)
        end
    end
end

task.spawn(main)

print("[SWILL] Скрипт загружен. Нажми X на GUI для остановки.")
