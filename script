-- SWILL | Murder Mystery 2 - Auto Coin Collector (Pure Object-Based)
-- Версия 2.0 | Без лицензий, без мусора

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

-- ===== НАСТРОЙКИ =====
local CONFIG = {
    ClickCooldown = 0.12,          -- Задержка между кликами
    MaxCollectRadius = 250,        -- Радиус сбора
    AutoRotateSpeed = 2.5,         -- Скорость поворота камеры (градусы/кадр)
    CheckInterval = 0.05,          -- Интервал проверки
}

-- ===== ПЕРЕМЕННЫЕ =====
local lastClick = 0
local totalCollected = 0
local running = true

-- ===== ПОИСК КОНТЕЙНЕРА С МОНЕТАМИ =====
local function getCoinContainer()
    -- Проверяем все возможные места хранения монет
    local possiblePaths = {
        workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Coins"),
        workspace:FindFirstChild("Coins"),
        workspace:FindFirstChild("CoinContainer"),
        workspace:FindFirstChild("Game") and workspace.Game:FindFirstChild("Coins"),
    }
    
    for _, container in pairs(possiblePaths) do
        if container and container:IsA("Folder") then
            return container
        end
    end
    
    -- Если не нашли по именам, ищем вручную
    for _, child in pairs(workspace:GetChildren()) do
        if child:IsA("Folder") and child.Name:lower():find("coin") then
            return child
        end
        if child:IsA("Model") and child.Name:lower():find("coin") then
            return child
        end
    end
    
    return nil
end

-- ===== ПОИСК БЛИЖАЙШЕЙ МОНЕТЫ =====
local function findNearestCoin()
    local character = LocalPlayer.Character
    if not character then return nil end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end
    
    local rootPos = rootPart.Position
    local nearest = nil
    local nearestDist = CONFIG.MaxCollectRadius
    
    local coinContainer = getCoinContainer()
    if not coinContainer then return nil end
    
    -- Проходим по всем монетам в контейнере
    for _, coinModel in pairs(coinContainer:GetChildren()) do
        if coinModel:IsA("Model") and coinModel.Name == "Coin" then
            -- Ищем Handle (кликабельную часть)
            local handle = coinModel:FindFirstChild("Handle")
            if not handle then
                -- Если Handle нет, берём любую часть
                handle = coinModel:FindFirstChildWhichIsA("BasePart")
            end
            
            if handle and handle:IsA("BasePart") then
                local pos = handle.Position
                local dist = (pos - rootPos).Magnitude
                
                -- Проверяем, существует ли монета (не собрана)
                if dist < nearestDist and handle.Transparency < 1 then
                    nearest = handle
                    nearestDist = dist
                end
            end
        end
    end
    
    return nearest, nearestDist
end

-- ===== КЛИК ПО МОНЕТЕ =====
local function clickCoin(screenPos)
    if tick() - lastClick < CONFIG.ClickCooldown then
        return
    end
    
    -- Эмуляция клика мыши
    UserInputService:SetMouseButtonState(Enum.UserInputType.MouseButton1, true)
    task.wait(0.04)
    UserInputService:SetMouseButtonState(Enum.UserInputType.MouseButton1, false)
    
    lastClick = tick()
    totalCollected = totalCollected + 1
    
    -- Выводим счётчик в консоль
    if totalCollected % 5 == 0 then
        print("[SWILL] Собрано монет: " .. totalCollected)
    end
end

-- ===== ПОВОРОТ КАМЕРЫ =====
local function rotateToPosition(targetPos)
    local character = LocalPlayer.Character
    if not character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    local rootPos = rootPart.Position
    local direction = (targetPos - rootPos).Unit
    local lookVector = Camera.CFrame.LookVector
    
    local angle = math.atan2(direction.X, direction.Z) - math.atan2(lookVector.X, lookVector.Z)
    local newCFrame = Camera.CFrame * CFrame.Angles(0, angle, 0)
    Camera.CFrame = Camera.CFrame:Lerp(newCFrame, 0.15)
end

-- ===== ОСНОВНОЙ ЦИКЛ СБОРА =====
local function collectLoop()
    print("[SWILL] Автосбор монет запущен")
    print("[SWILL] Ищем контейнер с монетами...")
    
    local container = getCoinContainer()
    if container then
        print("[SWILL] Найден контейнер: " .. container:GetFullName())
    else
        print("[SWILL] Контейнер не найден! Проверяем весь workspace...")
    end
    
    while running do
        task.wait(CONFIG.CheckInterval)
        
        -- Проверка: жив ли игрок
        if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("Humanoid") then
            continue
        end
        
        local coin, dist = findNearestCoin()
        
        if coin then
            -- Переводим 3D-позицию в экранные координаты
            local screenPos, onScreen = Camera:WorldToViewportPoint(coin.Position)
            
            if onScreen and screenPos.Z > 0 then
                -- Монета на экране — кликаем
                clickCoin(Vector2.new(screenPos.X, screenPos.Y))
            else
                -- Монета вне экрана — поворачиваем камеру
                rotateToPosition(coin.Position)
            end
        else
            -- Монет нет в радиусе — медленно вращаем камеру для поиска
            Camera.CFrame = Camera.CFrame * CFrame.Angles(0, math.rad(CONFIG.AutoRotateSpeed), 0)
        end
    end
end

-- ===== GUI ИНДИКАТОР =====
local function createGUI()
    local ScreenGui = Instance.new("ScreenGui")
    local Frame = Instance.new("Frame")
    local TextLabel = Instance.new("TextLabel")
    local CloseButton = Instance.new("TextButton")
    
    ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    ScreenGui.Name = "SWILL_CoinCollector"
    
    Frame.Parent = ScreenGui
    Frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    Frame.BackgroundTransparency = 0.6
    Frame.Size = UDim2.new(0, 200, 0, 40)
    Frame.Position = UDim2.new(0, 10, 0, 10)
    Frame.BorderSizePixel = 0
    
    TextLabel.Parent = Frame
    TextLabel.BackgroundTransparency = 1
    TextLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
    TextLabel.Size = UDim2.new(1, 0, 1, 0)
    TextLabel.Text = "SWILL | 0 монет"
    TextLabel.Font = Enum.Font.GothamBold
    TextLabel.TextSize = 16
    TextLabel.TextScaled = true
    
    CloseButton.Parent = Frame
    CloseButton.BackgroundTransparency = 1
    CloseButton.Size = UDim2.new(0, 25, 0, 25)
    CloseButton.Position = UDim2.new(1, -30, 0, 5)
    CloseButton.Text = "X"
    CloseButton.TextColor3 = Color3.fromRGB(255, 0, 0)
    CloseButton.TextScaled = true
    CloseButton.Font = Enum.Font.GothamBold
    
    CloseButton.MouseButton1Click:Connect(function()
        running = false
        ScreenGui:Destroy()
        print("[SWILL] Сбор остановлен")
    end)
    
    -- Обновление счётчика
    task.spawn(function()
        while running and ScreenGui.Parent do
            task.wait(0.5)
            TextLabel.Text = "SWILL | " .. totalCollected .. " монет"
        end
    end)
end

-- ===== ЗАПУСК =====
task.spawn(function()
    -- Ждём загрузки игрока
    while not LocalPlayer.Character do
        task.wait(0.5)
    end
    
    createGUI()
    collectLoop()
end)

print("[SWILL] Скрипт загружен. Идёт сбор монет...")
print("[SWILL] Нажми X на GUI для остановки")
