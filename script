-- SWILL | Murder Mystery 2 - Teleport Coin Collector
-- Версия 3.0 | Телепорт вместо кликов
-- Для Delta Executor на телефоне

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer

-- ===== НАСТРОЙКИ =====
local CONFIG = {
    TeleportRadius = 300,          -- Радиус поиска монет (больше = дальше телепорт)
    TeleportCooldown = 0.3,        -- Задержка между телепортами (сек)
    CheckInterval = 0.05,          -- Интервал проверки
    SafeTeleport = true,           -- Телепортироваться только к видимым монетам
}

-- ===== ПЕРЕМЕННЫЕ =====
local totalCollected = 0
local running = true
local lastTeleport = 0
local character = nil
local humanoidRootPart = nil

-- ===== ПОИСК КОНТЕЙНЕРА С МОНЕТАМИ =====
local function getCoinContainer()
    -- Проверяем все возможные места
    local paths = {
        workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Coins"),
        workspace:FindFirstChild("Coins"),
        workspace:FindFirstChild("CoinContainer"),
        workspace:FindFirstChild("Game") and workspace.Game:FindFirstChild("Coins"),
        workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Coin"),
    }
    
    for _, container in pairs(paths) do
        if container then
            return container
        end
    end
    
    -- Ручной поиск
    for _, child in pairs(workspace:GetChildren()) do
        if child:IsA("Folder") and child.Name:lower():find("coin") then
            return child
        end
        if child:IsA("Model") and child.Name:lower():find("coin") then
            return child
        end
    end
    
    return nil
end

-- ===== ПОЛУЧИТЬ ВСЕ МОНЕТЫ =====
local function getAllCoins()
    local coins = {}
    local container = getCoinContainer()
    
    if not container then
        return coins
    end
    
    for _, child in pairs(container:GetChildren()) do
        if child:IsA("Model") and child.Name == "Coin" then
            local handle = child:FindFirstChild("Handle")
            if not handle then
                handle = child:FindFirstChildWhichIsA("BasePart")
            end
            if handle and handle:IsA("BasePart") then
                -- Проверяем, что монета существует (не прозрачна и не собрана)
                if handle.Transparency < 0.9 then
                    table.insert(coins, handle)
                end
            end
        end
    end
    
    return coins
end

-- ===== ПОИСК БЛИЖАЙШЕЙ МОНЕТЫ =====
local function findNearestCoin()
    if not character or not humanoidRootPart then
        return nil
    end
    
    local rootPos = humanoidRootPart.Position
    local nearest = nil
    local nearestDist = CONFIG.TeleportRadius
    
    local allCoins = getAllCoins()
    
    for _, coin in pairs(allCoins) do
        local pos = coin.Position
        local dist = (pos - rootPos).Magnitude
        if dist < nearestDist then
            nearest = coin
            nearestDist = dist
        end
    end
    
    return nearest, nearestDist
end

-- ===== ТЕЛЕПОРТ К МОНЕТЕ =====
local function teleportToCoin(coin)
    if not character or not humanoidRootPart then
        return false
    end
    
    if tick() - lastTeleport < CONFIG.TeleportCooldown then
        return false
    end
    
    local coinPos = coin.Position
    
    -- Проверяем, не телепортируемся ли мы в стену
    if CONFIG.SafeTeleport then
        -- Добавляем небольшое смещение вверх, чтобы не застрять
        coinPos = coinPos + Vector3.new(0, 2, 0)
    end
    
    -- ТЕЛЕПОРТАЦИЯ
    humanoidRootPart.CFrame = CFrame.new(coinPos)
    
    lastTeleport = tick()
    totalCollected = totalCollected + 1
    
    if totalCollected % 5 == 0 then
        print("[SWILL] Собрано монет: " .. totalCollected)
    end
    
    return true
end

-- ===== ОБНОВЛЕНИЕ ССЫЛОК НА ПЕРСОНАЖА =====
local function updateCharacter()
    character = LocalPlayer.Character
    if character then
        humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        return true
    end
    return false
end

-- ===== ОСНОВНОЙ ЦИКЛ СБОРА =====
local function collectLoop()
    print("[SWILL] Автосбор с телепортацией запущен")
    print("[SWILL] Поиск контейнера с монетами...")
    
    -- Проверяем контейнер
    local container = getCoinContainer()
    if container then
        print("[SWILL] Найден контейнер: " .. container:GetFullName())
        print("[SWILL] Монет найдено: " .. #getAllCoins())
    else
        print("[SWILL] Контейнер не найден! Ищем вручную...")
    end
    
    -- Ждём появления персонажа
    while not updateCharacter() do
        task.wait(0.5)
    end
    
    print("[SWILL] Персонаж загружен. Начинаем сбор!")
    
    while running do
        task.wait(CONFIG.CheckInterval)
        
        -- Обновляем персонажа
        if not updateCharacter() then
            task.wait(1)
            continue
        end
        
        -- Проверка: жив ли игрок
        local humanoid = character:FindFirstChild("Humanoid")
        if not humanoid or humanoid.Health <= 0 then
            task.wait(1)
            continue
        end
        
        -- Ищем ближайшую монету
        local coin, dist = findNearestCoin()
        
        if coin then
            -- Телепортируемся к монете
            teleportToCoin(coin)
        else
            -- Если монет нет в радиусе, расширяем поиск
            if CONFIG.TeleportRadius < 1000 then
                CONFIG.TeleportRadius = CONFIG.TeleportRadius + 50
                if CONFIG.TeleportRadius % 200 == 0 then
                    print("[SWILL] Расширяем радиус поиска до " .. CONFIG.TeleportRadius)
                end
            else
                -- Если всё равно нет монет, сбрасываем радиус
                CONFIG.TeleportRadius = 300
                print("[SWILL] Монет не найдено. Ожидание новых...")
                task.wait(2)
            end
        end
    end
end

-- ===== GUI ИНДИКАТОР =====
local function createGUI()
    local ScreenGui = Instance.new("ScreenGui")
    local Frame = Instance.new("Frame")
    local TextLabel = Instance.new("TextLabel")
    local CloseButton = Instance.new("TextButton")
    
    ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    ScreenGui.Name = "SWILL_TeleportCollector"
    
    Frame.Parent = ScreenGui
    Frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    Frame.BackgroundTransparency = 0.6
    Frame.Size = UDim2.new(0, 220, 0, 50)
    Frame.Position = UDim2.new(0, 10, 0, 10)
    Frame.BorderSizePixel = 0
    
    TextLabel.Parent = Frame
    TextLabel.BackgroundTransparency = 1
    TextLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
    TextLabel.Size = UDim2.new(1, 0, 1, 0)
    TextLabel.Text = "SWILL | 0 монет"
    TextLabel.Font = Enum.Font.GothamBold
    TextLabel.TextSize = 16
    TextLabel.TextScaled = true
    
    CloseButton.Parent = Frame
    CloseButton.BackgroundTransparency = 1
    CloseButton.Size = UDim2.new(0, 25, 0, 25)
    CloseButton.Position = UDim2.new(1, -30, 0, 5)
    CloseButton.Text = "X"
    CloseButton.TextColor3 = Color3.fromRGB(255, 0, 0)
    CloseButton.TextScaled = true
    CloseButton.Font = Enum.Font.GothamBold
    
    CloseButton.MouseButton1Click:Connect(function()
        running = false
        ScreenGui:Destroy()
        print("[SWILL] Сбор остановлен")
    end)
    
    -- Обновление счётчика
    task.spawn(function()
        while running and ScreenGui.Parent do
            task.wait(0.5)
            TextLabel.Text = "SWILL | " .. totalCollected .. " монет"
        end
    end)
end

-- ===== ДИАГНОСТИКА =====
local function diagnostics()
    task.wait(2)
    print("[SWILL] ===== ДИАГНОСТИКА =====")
    print("[SWILL] Проверяем структуру workspace...")
    
    for _, child in pairs(workspace:GetChildren()) do
        print("[SWILL] " .. child.Name .. " (" .. child.ClassName .. ")")
        if child:IsA("Folder") or child:IsA("Model") then
            for _, sub in pairs(child:GetChildren()) do
                if sub.Name:lower():find("coin") then
                    print("[SWILL]   --> Найдено: " .. sub.Name)
                end
            end
        end
    end
    
    local container = getCoinContainer()
    if container then
        print("[SWILL] Контейнер найден: " .. container:GetFullName())
        print("[SWILL] Количество монет: " .. #getAllCoins())
    else
        print("[SWILL] Контейнер НЕ НАЙДЕН!")
        print("[SWILL] Попробуйте найти папку с монетами вручную")
        print("[SWILL] И изменить функцию getCoinContainer()")
    end
    print("[SWILL] ==========================")
end

-- ===== ЗАПУСК =====
task.spawn(function()
    -- Ждём загрузки игрока
    while not LocalPlayer.Character do
        task.wait(0.5)
    end
    
    -- Запускаем диагностику
    diagnostics()
    
    -- Создаём GUI
    createGUI()
    
    -- Запускаем сбор
    collectLoop()
end)

print("[SWILL] Скрипт загружен. Телепорт к монетам активирован!")
print("[SWILL] Нажми X на GUI для остановки")
