-- SWILL | Murder Mystery 2 - Coin Collector (Teleport Method)
-- Работает на Delta Executor (телефон)

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer

-- ===== НАСТРОЙКИ =====
local COLLECT_INTERVAL = 0.15
local TELEPORT_OFFSET = 2

-- ===== ПЕРЕМЕННЫЕ =====
local collected = 0
local running = true
local lastCollect = 0

-- ===== ПОИСК КАРТЫ =====
local function getMap()
    for _, child in pairs(workspace:GetChildren()) do
        if child:FindFirstChild("CoinContainer") then
            return child
        end
    end
    return nil
end

-- ===== ПОИСК БЛИЖАЙШЕЙ МОНЕТЫ =====
local function getClosestCoin()
    local map = getMap()
    if not map then return nil end
    
    local coinContainer = map:FindFirstChild("CoinContainer")
    if not coinContainer then return nil end
    
    local character = LocalPlayer.Character
    if not character then return nil end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    
    local coins = {}
    for _, child in pairs(coinContainer:GetChildren()) do
        if child:IsA("Model") and child.Name == "Coin" then
            table.insert(coins, child)
        end
    end
    
    if #coins == 0 then return nil end
    
    local closest = nil
    local closestDist = math.huge
    
    for _, coin in pairs(coins) do
        local pos = coin:GetPivot().Position
        local dist = (pos - root.Position).Magnitude
        if dist < closestDist then
            closestDist = dist
            closest = coin
        end
    end
    
    return closest, closestDist
end

-- ===== ТЕЛЕПОРТ К МОНЕТЕ =====
local function teleportToCoin(coin)
    local character = LocalPlayer.Character
    if not character then return false end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    
    if tick() - lastCollect < COLLECT_INTERVAL then
        return false
    end
    
    local pos = coin:GetPivot().Position
    root.CFrame = CFrame.new(pos + Vector3.new(0, TELEPORT_OFFSET, 0))
    
    lastCollect = tick()
    collected = collected + 1
    
    return true
end

-- ===== СОЗДАЁМ GUI =====
local function createGUI()
    local ScreenGui = Instance.new("ScreenGui")
    local Frame = Instance.new("Frame")
    local TextLabel = Instance.new("TextLabel")
    local CloseButton = Instance.new("TextButton")
    
    ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    ScreenGui.Name = "SWILL_CoinCollector"
    ScreenGui.ResetOnSpawn = false
    
    Frame.Parent = ScreenGui
    Frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    Frame.BackgroundTransparency = 0.6
    Frame.Size = UDim2.new(0, 200, 0, 50)
    Frame.Position = UDim2.new(0, 10, 0, 10)
    Frame.BorderSizePixel = 0
    
    TextLabel.Parent = Frame
    TextLabel.BackgroundTransparency = 1
    TextLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
    TextLabel.Size = UDim2.new(1, 0, 1, 0)
    TextLabel.Text = "SWILL | 0 монет"
    TextLabel.Font = Enum.Font.GothamBold
    TextLabel.TextSize = 16
    TextLabel.TextScaled = true
    
    CloseButton.Parent = Frame
    CloseButton.BackgroundTransparency = 1
    CloseButton.Size = UDim2.new(0, 25, 0, 25)
    CloseButton.Position = UDim2.new(1, -30, 0, 5)
    CloseButton.Text = "X"
    CloseButton.TextColor3 = Color3.fromRGB(255, 0, 0)
    CloseButton.TextScaled = true
    CloseButton.Font = Enum.Font.GothamBold
    
    CloseButton.MouseButton1Click:Connect(function()
        running = false
        ScreenGui:Destroy()
        print("[SWILL] Сбор остановлен")
    end)
    
    task.spawn(function()
        while running and ScreenGui.Parent do
            task.wait(0.5)
            TextLabel.Text = "SWILL | " .. collected .. " монет"
        end
    end)
    
    return ScreenGui
end

-- ===== ОСНОВНОЙ ЦИКЛ =====
local function main()
    print("[SWILL] Запуск авто-сбора монет в MM2")
    
    -- Создаём GUI
    local gui = createGUI()
    
    print("[SWILL] Начинаю сбор монет!")
    
    while running do
        task.wait(0.1)
        
        local character = LocalPlayer.Character
        if not character then
            task.wait(1)
            continue
        end
        
        local root = character:FindFirstChild("HumanoidRootPart")
        if not root then
            task.wait(1)
            continue
        end
        
        local coin = getClosestCoin()
        if not coin then
            task.wait(1)
            continue
        end
        
        teleportToCoin(coin)
    end
    
    print("[SWILL] Всего собрано: " .. collected .. " монет")
end

-- ===== ЗАПУСК =====
task.spawn(main)

print("[SWILL] Скрипт загружен. Нажми X на GUI для остановки.")
